Bundle-Name: Eclipse Fennec EMF Model MCP Tools
Bundle-Description: MCP tools to create, populate, validate and serialize EMF model instances backed by allow-listed EPackages
-workingset: emf

-library: enableEMF

-buildpath: \
	io.modelcontextprotocol.sdk.mcp-core;version=latest,\
	io.projectreactor.reactor-core;version=latest,\
	reactive-streams;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.osgi.framework;version=latest,\
	org.osgi.dto;version=latest,\
	org.eclipse.fennec.mcp.api;version=snapshot

# The codec metadata bridge is optional: without the Fennec codec in the
# runtime the tools work, only create_from_json/JSON export need it.
#
# Both metadata packages are listed because ModelGuard uses PackageMetadata, which lives in
# the second one - left to bnd's '*' it would become a mandatory import and quietly
# contradict the line above.
#
# Note what this does NOT buy: a runtime without the metadata layer. This bundle needs
# mcp.api, which imports org.eclipse.fennec.codec.metadata.model.codec mandatorily, and
# codec.metadata imports both metadata packages mandatorily - so the metadata bundle is in
# every runtime that can host these tools (proven by the resolve in emf.tools.tests). These
# stay optional as hygiene and to keep the manifest honest about what the code requires,
# not because the degraded path is a supported deployment.
Import-Package: \
	org.eclipse.fennec.emf.osgi.metadata;resolution:=optional,\
	org.eclipse.fennec.emf.osgi.model.metadata;resolution:=optional,\
	*

# component.minimal is test-only: it exports org.eclipse.fennec.emf.osgi.fingerprint.util,
# whose FingerprintHelper backs MetadataServices.createWhiteboard(). Needed to build a real
# metadata whiteboard in the tests — model identity there is a fingerprint, so a mock would
# not exercise the version addressing at all. Not a runtime dependency of this bundle.
-testpath: \
	assertj-core,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest