# Copy to `.env` next to this file and fill in. `.env` is git-ignored: it holds the endpoint
# token, which is a credential.
#
#     cp docker/inference/.env.example docker/inference/.env
#
# docker compose reads `.env` from the directory of the compose file automatically.

# Guards /mcp/inference. Any opaque string; the caller sends it as `Authorization: Bearer
# <token>`. Mandatory - see README.md ("Authentication"). If event.atlas is the caller, this
# must equal METAMODEL_MCP_TOKEN in that repo's secrets.bndrun.
MCP_INFERENCE_AUTH_TOKEN=

# REST base of the Model Atlas this runtime reads EPackages from and publishes back to,
# including the /atlas/rest suffix, e.g. https://atlas.example.org/atlas/rest. A locally run
# model.atlas jena container is http://host.docker.internal:8080/atlas/rest (declare
# `extra_hosts: ["host.docker.internal:host-gateway"]` on the service for that to resolve).
MODEL_ATLAS_BASE_URI=

# Atlas scope to publish into. `jena` in the standard model.atlas deployment.
MODEL_ATLAS_PUBLISHING_SCOPE=jena

# Namespace URIs an inference run may publish, '|'-separated, each exact or a prefix ending
# in '*'. Deny-all: leave this blank and nothing can be published.
MCP_ATLAS_PUBLISH_ALLOWLIST=https://fennec.eclipse.org/event.atlas/inferred*

# Optional. Defaults are draft / no-overwrite; both should stay that way unless you mean it.
#MODEL_ATLAS_PUBLISHING_STAGE=draft
#MODEL_ATLAS_OVERWRITE=false
