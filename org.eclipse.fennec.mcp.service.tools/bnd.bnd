Bundle-Name: Eclipse Fennec OSGi MCP Service Client Tools
Bundle-Description: Whiteboard bridge exposing ServiceClient operations (SOAP/OpenAPI/gRPC imports) as MCP tools

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.mcp.api;version=snapshot,\
	org.eclipse.fennec.service.api;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec.jsonschema;version=latest,\
	org.eclipse.fennec.model.metadata;version=latest,\
	org.eclipse.fennec.model.metadata.api;version=latest,\
	org.osgi.framework;version=latest,\
	io.modelcontextprotocol.sdk.mcp-core;version=latest,\
	io.projectreactor.reactor-core;version=latest,\
	reactive-streams;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	tools.jackson.core.jackson-core;version=latest

# The codec metadata bridge is optional; without it only tools whose packages
# are OSGi-registered can execute.
Import-Package: \
	org.eclipse.fennec.model.metadata.api;resolution:=optional,\
	org.eclipse.fennec.model.metadata;resolution:=optional,\
	*

-testpath: \
	assertj-core
