# Self-contained docker runtime for the metamodel-inference MCP endpoint: /mcp/inference,
# the 20 tools MCPToolProvider~inference filters, and the model.atlas publishing tool with
# its JAX-RS client. It does NOT serve /mcp/emf - that endpoint belongs to
# org.eclipse.fennec.mcp.emf.runtime, whose config bundle defines the same singleton PIDs
# and binds the same port, so the two are alternative images and not layers.
#
# Kept in sync with launch.bndrun: identical -runrequires, therefore the identical resolved
# -runbundles below. Three deliberate differences, all about running unattended in a
# container rather than at a developer's terminal:
#
#  1. No `-include: -secrets.bndrun`. Tokens and Model Atlas coordinates arrive as
#     environment variables, which is what docker and compose hand a process; the
#     interpolation plugin reads $[env:NAME] before $[prop:NAME], so the same configuration
#     JSON serves both without a second copy.
#  2. The Gogo shell runs non-interactively (-Dgosh.args=--nointeractive in the
#     ENTRYPOINT) and the builtin console is off: a container has no terminal, and a shell
#     blocking on stdin holds the framework open at shutdown.
#  3. The whiteboard must bind 0.0.0.0 rather than the 127.0.0.1 of a local run, or nothing
#     outside the container can reach it. That is a CONFIG value, not a bndrun one -
#     MCP_INFERENCE_HTTP_HOST in inference.config's runtime.json, which the Dockerfile sets.
#
# See docker/inference/README.md for the ports, the environment table, and why a token stops
# being optional the moment the endpoint is reachable from outside the container.
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active

# felix.cm.config.plugins wires the interpolation plugin that resolves the $[env:...]
# placeholders in inference.json (auth.token), runtime.json (the bind host), the atlas
# overlay's config.json (base.uri) and model.atlas.mcp.config's publisher.json (the
# publishing coordinates) as Configuration Admin delivers each configuration - which is what
# lets one published image serve every deployment.
-runproperties: \
	osgi.console=,\
	osgi.console.enable.builtin=false,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-21

-runrequires: \
	osgi.implementation;filter:='(osgi.implementation=mcp.inference)',\
	bnd.identity;id='slf4j.simple',\
	bnd.identity;id='org.eclipse.fennec.mcp.inference.runtime',\
	bnd.identity;id='org.eclipse.fennec.mcp.inference.config',\
	bnd.identity;id='org.eclipse.fennec.mcp.emf.runtime.config.atlas',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.osgi',\
	bnd.identity;id='org.eclipse.osgitech.rest',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle'

# Resolved set (bnd resolve). Re-resolve after changing -runrequires.
# SpiFly's framework extension embeds a 2023 ASM that refuses class files past V22, so its
# weaving hook fails on a Java 23+ JVM and takes org.apache.felix.http.jetty12 down with
# it - a runtime that starts with no HTTP endpoint at all. The dynamic.bundle variant
# imports org.objectweb.asm instead, so the ASM deployed next to it decides what class
# files the weaver can read.
-runblacklist: bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runbundles: \
	com.ethlo.time.itu;version='[1.14.0,1.14.1)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.22.0,2.22.1)',\
	com.networknt.json-schema-validator;version='[3.0.6,3.0.7)',\
	io.modelcontextprotocol.sdk.mcp-core;version='[2.0.0,2.0.1)',\
	io.modelcontextprotocol.sdk.mcp-json-jackson3;version='[2.0.0,2.0.1)',\
	io.projectreactor.reactor-core;version='[3.7.0,3.7.1)',\
	org.apache.commons.commons-fileupload;version='[1.6.0,1.6.1)',\
	org.apache.commons.commons-io;version='[2.22.0,2.22.1)',\
	org.apache.felix.cm.json;version='[2.0.0,2.0.1)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configadmin.plugin.interpolation;version='[1.2.8,1.2.9)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.http.jetty12;version='[1.1.0,1.1.1)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.metadata;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.mcp.api;version=snapshot,\
	org.eclipse.fennec.mcp.endpoint;version=snapshot,\
	org.eclipse.fennec.mcp.emf.tools;version=snapshot,\
	org.eclipse.fennec.mcp.http.component;version=snapshot,\
	org.eclipse.fennec.mcp.metadata.tools;version=snapshot,\
	org.eclipse.fennec.mcp.tool.provider;version=snapshot,\
	org.eclipse.parsson.jakarta.json;version='[1.1.7,1.1.8)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.snakeyaml.engine;version='[3.0.1,3.0.2)',\
	reactive-streams;version='[1.0.4,1.0.5)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)',\
	tools.jackson.core.jackson-core;version='[3.2.2,3.2.3)',\
	tools.jackson.core.jackson-databind;version='[3.2.2,3.2.3)',\
	tools.jackson.dataformat.jackson-dataformat-yaml;version='[3.2.2,3.2.3)',\
	org.eclipse.fennec.mcp.inference.runtime;version=snapshot,\
	org.eclipse.fennec.mcp.inference.config;version=snapshot,\
	org.eclipse.fennec.mcp.emf.runtime.config.atlas;version=snapshot,\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	org.eclipse.fennec.model.atlas.rest.client.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.model.atlas.rest.client.impl;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.model.atlas.rest.client.osgi;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.model.atlas.scope.api;version='[0.1.0,0.1.1)',\
	jakarta.activation-api;version='[2.1.2,2.1.3)',\
