Bundle-Name: Eclipse Fennec OSGi MCP Http Component
Bundle-Description: Component that uses the OSGi Http Whiteboard to publish MCP Tools

-buildpath: \
	org.osgi.namespace.implementation;version=latest,\
	org.osgi.framework;version=latest,\
	org.osgi.service.servlet;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	io.modelcontextprotocol.sdk.mcp-core;version=latest,\
	io.modelcontextprotocol.sdk.mcp-json-jackson3;version=latest,\
	org.eclipse.fennec.mcp.api;version=snapshot,\

Import-Package: \
	jakarta.servlet;version="[6.0,7)",\
	jakarta.servlet.http;version="[6.0,7)",\
	org.osgi.service.servlet.whiteboard;version="[2.0,3)",\
	*

